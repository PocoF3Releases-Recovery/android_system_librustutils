rust_library_rlib {
    name: "libbionic_panic_abort",
    crate_name: "bionic_panic_abort",
    defaults: ["rust_sysroot_defaults"],
    host_supported: false,
    sysroot: false,
    srcs: ["panic_abort.rs"],
    no_stdlibs: true,
}

rust_library_rlib {
    name: "liblibc_alloc_rust",
    crate_name: "libc_alloc",
    defaults: ["rust_sysroot_defaults"],
    host_supported: false,
    sysroot: false,
    srcs: ["libc_alloc.rs"],
    no_stdlibs: true,
}

// Apply this default if your normal C library or binary
// (not linker, libc, or baremetal) depends on only `no_std` Rust modules.
// If linker / libc / baremetal, depend on the two libraries above as
// appropriate.
cc_defaults {
    name: "rust_static_std",
    target: {
        android: {
            whole_static_libs: [
                "libstd",
            ],
        },
        musl_arm64: {
            whole_static_libs: [
                "libstd",
            ],
        },
        darwin_arm64: {
            whole_static_libs: [
                "libstd",
            ],
        },
        glibc: {
            whole_static_libs: [
                "prebuilt_libstd",
            ],
        },
        darwin_x86_64: {
            whole_static_libs: [
                "prebuilt_libstd",
            ],
        },
        musl_x86_64: {
            whole_static_libs: [
                "prebuilt_libstd",
            ],
        },
    },
}
