package {
    default_team: "trendy_team_android_rust",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libcap_rust.defaults",
    crate_name: "cap",
    edition: "2024",
    host_supported: true,

    srcs: ["src/lib.rs"],
    rustlibs: [
        "libbitflags",
        "libcap_bindgen",
        "liblibc",
        "libnix",
        "libscopeguard",
        "libthiserror",
    ],
    shared_libs: [
        "libcap",
    ],

    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "com.android.adbd",
        "com.android.art",
        "com.android.art.debug",
        "com.android.compos",
        "com.android.media.swcodec",
        "com.android.virt",
    ],
}

rust_bindgen {
    name: "libcap_bindgen",
    crate_name: "cap_bindgen",
    edition: "2024",
    host_supported: true,

    wrapper_src: "bindgen/libcap.h",
    source_stem: "bindings",
    shared_libs: ["libcap"],
    bindgen_flags: [
        "--default-enum-style rust",
    ],

    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "com.android.adbd",
        "com.android.art",
        "com.android.art.debug",
        "com.android.compos",
        "com.android.media.swcodec",
        "com.android.virt",
    ],
}

rust_test {
    name: "libcap_bindgen_test",
    srcs: [":libcap_bindgen"],
    defaults: ["avf_build_flags_rust"],
    crate_name: "cap_bindgen_test",
    test_suites: ["general-tests"],
    auto_gen_config: true,
    clippy_lints: "none",
    lints: "none",
}

rust_library {
    name: "libcap_rust",
    defaults: ["libcap_rust.defaults"],
}

rust_test {
    name: "libcap_rust.test",
    defaults: ["libcap_rust.defaults"],
    test_suites: ["general-tests"],
}
